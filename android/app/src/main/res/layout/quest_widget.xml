<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="13dp" android:orientation="vertical" android:gravity="center_vertical"
    android:background="@drawable/widget_bg">
    <TextView android:id="@+id/widget_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="✦ ASCENT  /  DAILY QUEST" android:textColor="#A3B9FF"
        android:textStyle="bold" android:letterSpacing="0.08" android:textSize="11sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:layout_marginTop="7dp">
        <TextView android:id="@+id/widget_level" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="LV.1  ·  E-RANK"
            android:textColor="#F0F4FF" android:textStyle="bold" android:textSize="15sp" />
        <TextView android:id="@+id/widget_exp" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="0 EXP"
            android:textColor="#99C5EF" android:textSize="12sp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_distance" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="7dp"
        android:text="0.00 / 2.0 กม." android:textColor="#FFFFFF"
        android:textStyle="bold" android:textSize="22sp" />
    <ProgressBar android:id="@+id/widget_distance_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="5dp"
        android:progress="0" android:max="100" android:progressTint="#7ECFED"
        android:progressBackgroundTint="#23385B" android:layout_marginTop="7dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:layout_marginTop="6dp" android:orientation="horizontal">
        <TextView android:id="@+id/widget_total" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content"
            android:text="สะสม 0.0 กม." android:textColor="#A5B6D2" android:textSize="11sp" />
        <TextView android:id="@+id/widget_water" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="💧 0/6 · +1"
            android:textColor="#89E4FC" android:background="@drawable/widget_water_bg"
            android:textSize="11sp" android:paddingLeft="8dp" android:paddingRight="8dp"
            android:paddingTop="6dp" android:paddingBottom="6dp" android:clickable="true" />
    </LinearLayout>
    <TextView android:id="@+id/widget_quest" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="แตะเพื่อเปิด ASCENT"
        android:maxLines="1" android:ellipsize="end" android:layout_marginTop="5dp"
        android:textColor="#C5D6F1" android:textSize="11sp" />
</LinearLayout>
